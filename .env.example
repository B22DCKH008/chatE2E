# Local development only. Compose works with these defaults without a .env file.
# Use URL-safe values here; percent-encode credentials in URLs if needed.
POSTGRES_USER=secureai
POSTGRES_PASSWORD=secureai_dev_only
POSTGRES_DB=secureai
REDIS_PASSWORD=redis_dev_only
NATS_AUTH_TOKEN=nats_dev_only
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# For go run on the HOST. Compose builds its own internal service URLs.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://secureai:secureai_dev_only@localhost:5432/secureai?sslmode=disable
REDIS_URL=redis://:redis_dev_only@localhost:6379/0
NATS_URL=nats://nats_dev_only@localhost:4222
MAX_BODY_BYTES=1048576
DEPENDENCY_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s

